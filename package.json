{
  "name": "@dev4press/field-text",
  "version": "1.0.0",
  "description": "Modular TypeScript library for working with input fields.",
  "type": "module",
  "main": "./dist/field-text.umd.cjs",
  "module": "./dist/field-text.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/field-text.js"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./dist/field-text.umd.cjs"
      }
    },
    "./field-text.css": {
      "types": "./types/field-text.css.d.ts",
      "default": "./dist/field-text.css"
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:package": "npm run build && tsc -p test/package",
    "lint:ts": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"vite.config.ts\"",
    "lint:scss": "stylelint \"src/**/*.scss\"",
    "lint": "npm run lint:ts && npm run lint:scss",
    "format": "prettier --write \"src/**/*.{ts,scss}\" \"test/**/*.{ts,mts,cts}\" \"types/**/*.{ts,cts}\" \"vite.config.ts\" \"eslint.config.js\"",
    "format:check": "prettier --check \"src/**/*.{ts,scss}\" \"test/**/*.{ts,mts,cts}\" \"types/**/*.{ts,cts}\" \"vite.config.ts\" \"eslint.config.js\"",
    "build": "npm run check && vite build && tsc -p tsconfig.lib.json",
    "predev": "npm run build",
    "dev": "vite"
  },
  "files": [
    "dist",
    "types",
    "license.txt",
    "readme.md",
    "changelog.md",
    "documentation"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dev4press/field-text.git"
  },
  "bugs": {
    "url": "https://github.com/dev4press/field-text/issues"
  },
  "homepage": "https://www.dev4press.com/",
  "keywords": [
    "field",
    "text",
    "counter",
    "typescript",
    "sass"
  ],
  "author": "Milan Petrovic",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "stylelint": "^18.0.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
